# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/career_copilot_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# JWT Configuration
# Generate a strong base64-encoded 256-bit key
JWT_SECRET=your_strong_base64_encoded_jwt_secret_at_least_32_bytes
JWT_EXPIRATION=86400000

# Gemini API (Phase 6+, not needed for Phase 1)
# GEMINI_API_KEY=your_gemini_api_key
